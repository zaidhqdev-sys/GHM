# Copy to payfast-qualification.env (gitignored) and source it in your shell.
# These credentials are intentionally disposable and only match the local
# PostgreSQL container in docker-compose.payfast-qualification.yml.
export NODE_ENV=test
export DATABASE_URL=postgres://ghm_runtime:local-runtime-only@localhost:55432/ghm
export GHM_RUNTIME_DATABASE_URL=postgres://ghm_runtime:local-runtime-only@localhost:55432/ghm
export GHM_MIGRATOR_DATABASE_URL=postgres://ghm_migrator:local-migrator-only@localhost:55432/ghm
export GHM_PAYMENT_PROVIDER_DATABASE_URL=postgres://ghm_payment_provider:local-provider-only@localhost:55432/ghm
export GHM_MIGRATION_DATABASE_NAME=ghm
export GHM_MIGRATION_DATABASE_HOST=localhost
export GHM_QUALIFICATION_DATABASE_NAME=ghm
export GHM_QUALIFICATION_DATABASE_HOST=localhost
export GHM_NONPRODUCTION_DATABASE_NAME=ghm
export GHM_NONPRODUCTION_DATABASE_HOST=localhost
export DATABASE_SSL=false
export INVITE_CODE=local-payfast-qualification-only
export CORS_ORIGINS=http://localhost:3000
export GHM_AUTH_TOKEN_PEPPER=local-only-test-pepper-not-for-any-deployment-000000000000000
