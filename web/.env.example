# GHM web frontend — local development
# Resource requests use the Internal Runtime / Resource API origin.
VITE_GHM_API_BASE_URL=https://ghm-internal-runtime.onrender.com

# Optional separate Authentication Issuer origin for login/refresh/logout only.
# Leave blank to preserve existing behavior until non-production issuer routing
# has been deployed and end-to-end verified.
VITE_GHM_AUTH_ISSUER_BASE_URL=
