{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./index.ts",
    "./cloudflare-node.d.ts",
    "../../src/actor-gateway/**/*.ts",
    "../../src/auth/foundation/**/*.ts",
    "../../src/integrations/connect/business-provisioning-contracts.ts"
  ]
}
