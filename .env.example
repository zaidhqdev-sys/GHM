# Runtime
NODE_ENV=development
PORT=3000

# Application runtime database connection
DATABASE_URL=

# Standalone migration connection. This must resolve to the dedicated ghm_migrator login.
GHM_MIGRATOR_DATABASE_URL=
# Required exact allowlist for migration execution; use the approved target, never a runtime default.
GHM_MIGRATION_DATABASE_NAME=
# One-off non-production DB qualification only; set the exact approved target before running.
# Never point qualification scripts at production. Keep connection credentials in local secret storage.
GHM_RUNTIME_DATABASE_URL=
GHM_NONPRODUCTION_DATABASE_HOST=
GHM_NONPRODUCTION_DATABASE_NAME=

GHM_MIGRATION_DATABASE_HOST=

# Required construction/runtime invite code; keep actual value out of source control
INVITE_CODE=

# Explicit comma-separated trusted frontend origins
CORS_ORIGINS=http://localhost:3000

# Set true only when deployed behind a trusted HTTPS reverse proxy
TRUST_PROXY=false

# Storage runtime boundary
# Provider-neutral application configuration; production values belong only in deployment secret/config management.
# For Cloudflare R2, set STORAGE_ENDPOINT to the account-level S3 API endpoint (HTTPS) and STORAGE_REGION=auto.
# Keep the bucket name separate from the endpoint; never commit access keys or secrets.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=
STORAGE_UPLOAD_GRANT_TTL_SECONDS=900
STORAGE_DOWNLOAD_GRANT_MAX_TTL_SECONDS=3600

# Explicit qualification targets (required before any fixture-mutating qualification).
GHM_QUALIFICATION_DATABASE_NAME=
GHM_QUALIFICATION_DATABASE_HOST=
# QuoteFlow migration password-reset delivery boundary.
# Server-side only; leave both blank until an approved HTTPS endpoint is reviewed.
GHM_RECOVERY_DELIVERY_WEBHOOK_URL=
GHM_RECOVERY_DELIVERY_WEBHOOK_TOKEN=
