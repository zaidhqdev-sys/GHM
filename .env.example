# Runtime
NODE_ENV=development
PORT=3000

# Production Resource API database connection; must authenticate directly as ghm_runtime.
GHM_RUNTIME_DATABASE_URL=

# Non-production fallback only. Production requires GHM_RUNTIME_DATABASE_URL.
DATABASE_URL=

# Standalone migration connection. This must resolve to the dedicated ghm_migrator login.
GHM_MIGRATOR_DATABASE_URL=

# Required construction/runtime invite code; keep actual value out of source control
INVITE_CODE=

# Explicit comma-separated trusted frontend origins
CORS_ORIGINS=http://localhost:3000

# Prefer TRUST_PROXY_HOPS set to the topology-verified number of trusted proxy hops.
# On Render, validate the effective X-Forwarded-For chain before choosing a hop count;
# do not use an unrestricted trust setting for IP-based rate limiting.
TRUST_PROXY_HOPS=
# Legacy compatibility only; prefer TRUST_PROXY_HOPS.
TRUST_PROXY=false

# Storage runtime boundary
# Provider-neutral application configuration; production values belong only in deployment secret/config management.
# For Cloudflare R2, use the account-level S3 API endpoint (HTTPS) and STORAGE_REGION=auto.
# Keep the bucket name separate from the endpoint; never commit access keys or secrets.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=
STORAGE_UPLOAD_GRANT_TTL_SECONDS=900
STORAGE_DOWNLOAD_GRANT_MAX_TTL_SECONDS=3600


# Public ES256 verification material shared by Resource API, Actor Gateway and Auth Issuer.
# Only the isolated Auth Issuer also receives the private signing key and token pepper below.
GHM_JWT_ES256_PUBLIC_KEY_PEM=
GHM_JWT_ES256_KID=
GHM_JWT_ES256_PREVIOUS_PUBLIC_KEY_PEM=
GHM_JWT_ES256_PREVIOUS_KID=

# Isolated GHM Actor Gateway service only (never add its database URL to the Resource API).
GHM_ACTOR_GATEWAY_DATABASE_URL=


# Optional. When set, Business registration identity reads use the isolated
# Actor Gateway. Requests fail closed if the gateway is unavailable; no legacy
# database fallback is attempted. Leave unset until the gateway is deployed
# and end-to-end verified.
GHM_ACTOR_GATEWAY_URL=


# Isolated GHM Authentication Issuer service configuration.
# Only the issuer service receives this dedicated database URL and CORS allow-list.
GHM_AUTH_ISSUER_DATABASE_URL=
GHM_AUTH_ISSUER_DATABASE_SSL_MODE=
GHM_AUTH_ISSUER_CORS_ORIGINS=
# Explicit trusted proxy hop count; production must set 0 for direct or the verified hop count.
GHM_AUTH_ISSUER_TRUST_PROXY_HOPS=

# Issuer-only signing and opaque-token custody. Never set these on the Resource API
# or Actor Gateway. Those processes use public verification keys only.
GHM_AUTH_TOKEN_PEPPER=
GHM_JWT_ES256_PRIVATE_KEY_PEM=

# Optional browser-cookie issuer contract. Keep Connect browser auth disabled unless
# the same-origin BFF, cookie policy and end-to-end flow have been qualified.
GHM_WEB_AUTH_ALLOWED_ORIGINS=
GHM_WEB_AUTH_COOKIE_PATH=/api/ghm
GHM_WEB_AUTH_COOKIE_MAX_AGE_SECONDS=
