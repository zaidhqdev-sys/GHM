{
  "name": "ghm-core",
  "version": "2.0.0",
  "description": "GHM Core Engine - Private Backend as a Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "migrate": "npm run build && node dist/db/migrate.js",
    "capture:postgres-catalog": "node scripts/capture-postgres-catalog.mjs",
    "qualify:business-identity-runtime": "npm run build && node scripts/qualify-business-identity-runtime.mjs",
    "qualify:authorization-http": "npm run build && node scripts/qualify-authorization-http.mjs",
    "qualify:resource-api-http": "npm run build && node scripts/qualify-resource-api-http.mjs",
    "qualify:operational-boundary": "npm run build && node scripts/qualify-operational-boundary.mjs",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/auth/authorization.test.js dist/auth/request-context.test.js dist/resources/registry.test.js dist/db/transaction.test.js dist/resources/business-identity/service.test.js dist/resources/project/service.test.js dist/resources/enquiry/service.test.js dist/resources/review/service.test.js dist/resources/opportunity/service.test.js dist/resources/opportunity/repository.test.js dist/http/app.test.js dist/http/enquiry-router.test.js dist/resources/project-quote/service.test.js dist/resources/opportunity-requirements/repository.test.js dist/resources/capability/service.test.js dist/resources/commercial/repository.test.js dist/resources/commercial/service.test.js dist/resources/customer/service.test.js dist/resources/quote/service.test.js dist/resources/notification/service.test.js dist/resources/notification/repository.test.js dist/resources/support-request/service.test.js",
    "verify:runtime": "node scripts/verify-runtime-boundary.mjs",
    "qualify:project-runtime": "npm run build && node scripts/qualify-project-runtime.mjs",
    "qualify:opportunity-runtime": "npm run build && node scripts/qualify-opportunity-runtime.mjs",
    "qualify:enquiry-runtime": "npm run build && node scripts/qualify-enquiry-runtime.mjs",
    "qualify:project-quote-runtime": "npm run build && node scripts/qualify-project-quote-runtime.mjs",
    "qualify:capability-runtime": "npm run build && node scripts/qualify-capability-runtime.mjs",
    "qualify:opportunity-requirements-runtime": "npm run build && node scripts/qualify-opportunity-requirements-runtime.mjs",
    "qualify:opportunity-participant-runtime": "npm run build && node scripts/qualify-opportunity-participant-runtime.mjs",
    "qualify:customer-runtime": "npm run build && node scripts/qualify-customer-runtime.mjs",
    "qualify:quote-runtime": "npm run build && node scripts/qualify-quote-runtime.mjs",
    "qualify:notification-runtime": "npm run build && node scripts/qualify-notification-runtime.mjs",
    "qualify:support-request-runtime": "npm run build && node scripts/qualify-support-request-runtime.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/client-s3-presigner": "^3.500.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pg": "^8.11.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}